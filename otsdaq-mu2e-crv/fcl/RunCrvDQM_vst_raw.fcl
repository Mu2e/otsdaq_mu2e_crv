# File-based dry run of the TDAQ CrvDQM module on VST-stream raw .art.
# Decode with CrvDigisFromArtdaqFragmentsFEBII, then CrvDQM.
# Does not talk to hardware, otsdaq VisualSupervisor, or HistoSender.
#
# Drive with tdaq_run_crv_dqm.sh (TDAQ Spack env + local Offline/otsdaq install).
# Do not run this with muse `mu2e`.

#include "Offline/fcl/standardServices.fcl"

process_name : CrvDQM

services : {
  @table::Services.Core
  @table::Services.Reco
  TFileService : {
    fileName : "crvDQM.root"
  }
}

source : {
  module_type : RootInput
  fileNames   : @nil
  maxEvents   : -1
}

physics : {
  producers : {
    crvdigi : {
      module_type    : CrvDigisFromArtdaqFragmentsFEBII
      diagLevel      : 0
      produceNZS     : false
      useROC4asROC2  : true
    }
  }
  analyzers : {
    crvdqm : {
      module_type      : CrvDQM
      crvDigiTag       : "crvdigi"
      crvStatusTag     : "crvdigi"
      diagLevel        : 1
      sendHists        : false
      enableHttpServer : false
      dummyHist        : false
      cfFraction       : 0.20
      dtBinSize        : 0.5
      dtRange          : 50.0
      minAmplitude     : 10
      saveCanvasesToPdf: false
      showSameFpgaTimingInCanvas: false

      # Histogram segmentation. This is the file-mode dry run, so unlike the
      # live RunCrvDQM.fcl it sets persist/persistLive TRUE -- writing the
      # copies to the output file is the only way to inspect them offline.
      # The span is short for the same reason: a few thousand events have to
      # be enough to see the ring rotate. Live online uses 50000 EWT and
      # writes nothing; see CrvDQM_segmentation_examples.fcl.
      segmentation : {
        rules : [
          { match    : "h1_channels"
            modes    : [ "job", "window" ]
            window   : { span : 2000  unit : "ewt"  subdivisions : 10
                         keep : 3  persist : true  persistLive : true }
            liveName : "h1_channelsLastEwt"
          },

          { match    : "dtOutOfRangePerFeb"
            modes    : [ "job", "window" ]
            window   : { span : 2000  unit : "ewt"  subdivisions : 10
                         keep : 3  persist : true  persistLive : true }
            liveName : "dtOutOfRangePerFebLastEwt"
          },

          # Thousands of these; a window rule would clone every one ten times.
          { match : "timing_fpga/*"  modes : [ "job" ] }
        ]
      }
    }
  }
  t1 : [ crvdigi ]
  a1 : [ crvdqm ]
  trigger_paths : [ t1 ]
  end_paths     : [ a1 ]
}

services.TimeTracker.printSummary: true
services.scheduler.wantSummary: true
services.message.destinations.log.outputStatistics : false
services.GeometryService.inputFile: "Offline/Mu2eG4/geom/geom_common_extracted.txt"

# Same VST 124155 conditions as unpack_data_vst.fcl (no CRV IOV in the DB).
services.ProditionsService.crvStatus.useDb : true
services.ProditionsService.crvCalib.useDb  : true
services.DbService.purpose : Sim_best
services.DbService.version : v1_5
services.DbService.textFile : [
  "Offline/CRVConditions/data/status_extracted_20260630.txt",
  "Offline/CRVConditions/data/calib_extracted_20260630.txt",
  "Offline/TrackerConditions/data/TrkPanelMap.txt"
]
services.DbService.verbose : 0
services.ProditionsService.trackerPanelMap.useDb : true
